---
import type { Stone } from '@canteras/shared';
import { joinList, usesLabel } from '../lib/format';
import Photo from './Photo.astro';

interface Props {
  stone: Stone;
}

const { stone } = Astro.props;
---

<a class="tile" href={`/stones/${stone.id}/`}>
  <Photo photoKey={stone.fotos[0]} ratio="4 / 5" />
  <span class="tile__row">
    <span class="tile__name">{stone.nombre}</span>
    <span class="tile__meta">{joinList(stone.colores.slice(0, 2))}</span>
  </span>
  <span class="tile__sub">{usesLabel(stone)}</span>
</a>
