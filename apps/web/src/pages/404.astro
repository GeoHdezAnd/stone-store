---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <main id="contenido" class="container construction">
    <span class="eyebrow">Error 404</span>
    <h1 class="page-title">No encontramos esta página</h1>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">
        Ir al inicio
      </a>
      <a class="btn btn-ghost" href="/catalog/">
        Ver el catálogo
      </a>
    </div>
  </main>
</BaseLayout>
